#!/usr/bin/env bash

set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR_PATH="$DIR/target/credit-simulator.jar"

if [ ! -f "$JAR_PATH" ]; then
    echo "Error: $JAR_PATH tidak ditemukan."
    echo "Jalankan 'mvn clean package' dulu sebelum menjalankan script ini."
    exit 1
fi

exec java -jar "$JAR_PATH" "$@"
